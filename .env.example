# Copy to .env.local and fill in. Every value degrades on its own rather than
# breaking the build, so you can bring the stack up a piece at a time.

# REST base URL — the SAM stack's `HttpApiUrl` output.
# Unset: requests go to /api and nothing works without a backend.
VITE_API_BASE=

# Realtime endpoint — the SAM stack's `WebSocketUrl` output.
# Unset: realtime is disabled and the app runs over plain HTTP.
VITE_WS_URL=

# Google Identity Services client id. Must match the backend's GoogleClientId
# parameter, or ID token verification will reject the audience.
# Unset: Google sign-in is hidden and only Masky is offered.
VITE_GOOGLE_CLIENT_ID=

# Verification site keys are NOT build-time config. They come from GET /config
# at runtime, so rotating a VoiceCert or Turnstile key is a stack parameter
# change rather than a frontend rebuild plus a CloudFront invalidation.
